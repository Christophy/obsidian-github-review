{
    "name": "obsidian-github-review",
    "version": "0.1.2",
    "description": "Read, comment on, and approve/request-changes on GitHub issues & pull requests. GitHub stays the source of truth.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "lint": "eslint .",
        "test": "run-s test:unit",
        "test:unit": "tsc --noEmit && mocha",
        "test:e2e": "npm run build && wdio run ./wdio.conf.mts"
    },
    "keywords": [
        "obsidian",
        "github",
        "review",
        "pull-request",
        "issue"
    ],
    "author": "Christophy",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Christophy/obsidian-github-review.git"
    },
    "bugs": {
        "url": "https://github.com/Christophy/obsidian-github-review/issues"
    },
    "homepage": "https://github.com/Christophy/obsidian-github-review#readme",
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^18.19.130",
        "@wdio/cli": "^9.27.1",
        "@wdio/globals": "^9.17.0",
        "@wdio/local-runner": "^9.27.1",
        "@wdio/mocha-framework": "^9.27.1",
        "@wdio/spec-reporter": "^9.27.1",
        "chai": "^5.3.3",
        "esbuild": "^0.25.12",
        "eslint": "^9.39.4",
        "eslint-plugin-obsidianmd": "^0.1.9",
        "globals": "^14.0.0",
        "jiti": "^2.7.0",
        "mocha": "^10.8.2",
        "npm-run-all2": "^7.0.2",
        "obsidian": "^1.12.3",
        "obsidian-launcher": "^3.0.3",
        "tslib": "^2.8.1",
        "tsx": "^4.22.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.3",
        "wdio-obsidian-reporter": "^3.0.3",
        "wdio-obsidian-service": "^3.0.3"
    },
    "dependencies": {
        "yaml": "^2.9.0"
    }
}
